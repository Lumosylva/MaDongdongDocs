# Waline 服务端环境变量示例。
# 部署时复制为同目录 `.env` 填写真实值；`.env` 已被 .gitignore 忽略，切勿提交。
# 本文件由 systemd 的 EnvironmentFile 注入进程；应用本身不会自动读取 .env。
# 修改任意变量后必须 `sudo systemctl restart waline` 才生效。

# ===== 站点基础 =====
# 站点名称（通知邮件 / 后台展示用）
SITE_NAME=马东东的技术教程
# 主站地址（带协议，末尾不带斜杠）
SITE_URL=https://docs.madongdong.com
# Waline 服务端自身的可信地址（密码重置邮件链接用，必须是对外可访问的 HTTPS 地址）
SERVER_URL=https://comment.madongdong.com
# 安全域名：站点域名 + 后端域名，逗号分隔，不含协议、不含端口
SECURE_DOMAINS=docs.madongdong.com,comment.madongdong.com

# ===== 数据库：SQLite（默认启用）=====
# 适配器选择优先级：MongoDB > PostgreSQL > SQLite > MySQL > TiDB。
# 只要配置了 SQLITE_PATH 就走 SQLite；后续切 MySQL 时删除/注释下面三行 SQLite 变量再填 MySQL 段。
# SQLite 数据库文件所在目录（不含文件名），需保证运行用户可读写
SQLITE_PATH=/var/www/waline/data
# 数据库文件名（不含后缀），默认 waline
SQLITE_DB=waline
# 数据表前缀
SQLITE_PREFIX=wl_
# 必填：登录/签名密钥，强随机串。生产机生成：openssl rand -hex 32
JWT_TOKEN=请替换为 openssl rand -hex 32 生成的强随机串

# ===== 评论审核 / 反垃圾 =====
# 评论先审后显：true = 新评论需管理员在后台通过后才展示
COMMENT_AUDIT=true
# 同一 IP 两次评论最小间隔（秒），0 表示不限制
IPQPS=60
# 敏感词，逗号分隔；命中后按反垃圾规则拦截/进入待审
FORBIDDEN_WORDS=广告,加微信,代购,赌博,刷单
# Akismet 默认开启（内置公共 Key）；确实要关闭设为 false。如需自己的 Key 再填写
# AKISMET_KEY=

# ===== 邮件通知（QQ 邮箱 SMTP）=====
# 未配置邮件前，后端可先启动；审核/后台注册可用，仅不发通知邮件。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# 465 端口使用 SSL，置 true；587 端口一般置 false（STARTTLS）
SMTP_SECURE=true
# SMTP 用户名：完整 QQ 邮箱地址
SMTP_USER=你的QQ号码@qq.com
# SMTP 授权码（QQ 邮箱设置 → 账号 → SMTP 服务生成的授权码，不是邮箱登录密码）
SMTP_PASS=QQ邮箱SMTP授权码
# 发件人展示名
SENDER_NAME=马东东的技术教程
# 发件人邮箱，通常与 SMTP_USER 一致
SENDER_EMAIL=你的QQ号码@qq.com
# 博主（管理员）邮箱：接收新评论通知；后台审核身份与之对应
AUTHOR_EMAIL=管理员接收通知邮箱@example.com

# ===== 备用：MySQL（默认不启用）=====
# 切换步骤：注释/删除上面 SQLite 段的 SQLITE_PATH、SQLITE_DB、SQLITE_PREFIX，再填写本段。
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DB=waline
# MYSQL_USER=waline
# MYSQL_PASSWORD=数据库密码
# MYSQL_PREFIX=wl_
# MYSQL_CHARSET=utf8mb4
# MYSQL_SSL=false
