{
  "name": "madongdong-docs",
  "version": "1.0.0",
  "private": true,
  "description": "马东东的技术教程 - 自建学习笔记 / 教程站点（VitePress）",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && npx pagefind --site docs/.vitepress/dist --exclude-selectors div.aside,a.header-anchor",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "devDependencies": {
    "@waline/client": "^3.16.2",
    "debug": "^4.4.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.0.0",
    "pagefind": "^1.6.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-plugin-pagefind": "^0.4.27"
  }
}
